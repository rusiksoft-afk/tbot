# Нормализация переводов строк: в репозитории хранится LF, рабочих копий на Windows это не
# ломает, но скрипты, попадающие в Linux-контейнеры, всегда получают LF.
* text=auto

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.j2 text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.po text eol=lf
*.pot text eol=lf

# Файлы хоста из deploy/vps их читает bash на Linux (парсер ufw.rules, jail.local):
# CRLF в рабочих копиях Windows ломает разбор тихо, без ошибки.
deploy/vps/*.rules text eol=lf
deploy/vps/*.local text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.zip binary
*.dat binary

# Защита от случайного коммита ключей и секретов (двойная страховка к .gitignore).
*.pem binary
*.key binary

# Файлы боевого запуска: их читает docker compose и Caddy на Linux. CRLF в env-file
# ломает значение тихо — CR попадает в digest, и pull требует несуществующий образ.
deploy/caddy/Caddyfile text eol=lf
deploy/*.env text eol=lf
