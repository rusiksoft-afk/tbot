# Секреты и ключи — никогда не коммитить (TZ §15.4, TZ §8.4)
ssh-key/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.known_hosts
known_hosts
*.kdbx

# Публичный корневой сертификат НУЦ — артефакт сборки образа (deploy/ca/README.md, T-006/T-709):
# без файла в коммите `COPY deploy/ca/` кладёт в образ только инструкцию, сборка остаётся зелёной,
# а доверия к брокеру в образе нет. Отпечаток закреплён в scripts/ca_policy.py. Приватные ключи
# по-прежнему не попадают в репозиторий: правила выше (*.key, *.p12, *.pfx) остаются в силе.
!deploy/ca/*.pem

# Ключ шифрования токенов (KEK) — только на хосте, права 0400
keys/
*.kek
kek*.json

# Окружение и локальные конфиги с токенами
.env
.env.*
!.env.example
configs/local.yaml
configs/*.local.yaml
configs/secrets/
# Секреты compose-стенда: compose разрешает `./secrets/...` относительно deploy/compose.yaml,
# поэтому каталог лежит в deploy/, а не в корне репозитория.
deploy/secrets/
secrets/

# Данные и артефакты
backups/
data/
parquet/
*.dump
*.pgdata/
.history/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
# артефакты локальной установки пакета в dev-режиме (`pip install -e .`)
*.egg-info/
*.log

# Инструменты и IDE
.idea/
.vscode/
*.swp
.DS_Store

# Локальные выгрузки исследований (документация брокера целиком — не в git)
docs/research/raw/
docs/acceptance/_private/

# Разрешаем примеры
!configs/tbot.example.yaml
!configs/commissions.example.yaml
!.env.example
