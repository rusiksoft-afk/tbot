# Правила ufw для рабочей ВМ (TZ §8.3 «вход наружу: только 443 и 22», TZ §14.5 «UFW default-deny»).
#
# Файл читает `deploy/vps/firewall.sh` построчно; порядок важен: правила добавляются ДО
# `ufw enable`, иначе включение файрвола с политикой deny incoming обрывает текущий SSH-вход.
#
# Почему не `ufw.yaml` (как значилось в задачах): ufw не читает YAML, форматом правит
# `firewall.sh`, а этот файл остаётся человекочитаемым списком того, что должно быть включено.

# Политика по умолчанию: входящий — запрещён, исходящий — разрешён (приложения ходят на брокера
# и Telegram), пересылаемый — разрешён.
#
# routed=ACCEPT обязателен с Docker: контейнеры идут через FORWARD, а Ubuntu по умолчанию ставит
# там DROP — без этого у контейнеров не поднимается egress к брокеру, и выглядит это как
# «приложение не видит рынок». Скрипт применяет это как DEFAULT_FORWARD_POLICY в /etc/default/ufw.
# Ограничения «куда именно можно» настраиваются отдельной цепочкой DOCKER-USER (TZ §8.5,
# egress-политика), а не этим файлом.
policy incoming deny
policy outgoing allow
policy routed allow

# Разрешённые входящие порты. 80 нужен только для редиректа на 443 и для ACME-вызовов
# Let's Encrypt; панель и API — на 443.
allow 22/tcp comment ssh
allow 80/tcp comment http-to-https
allow 443/tcp comment caddy-panel

# Публикуемых портов сверх этого нет: база (`5432`) и внутренние сервисы (`8080/9101/9103`)
# наружу не смотрят — в боевом составе они не публикуются, а dev-публикация — только loopback
# (см. deploy/compose.override.yaml и тест compose-контракта).
