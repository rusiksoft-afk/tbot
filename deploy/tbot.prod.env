# Что именно запускать на площадке: фиксированные digest образов (TZ §14.6, ADR-002).
#
# Это **не секрет**: digest — публичный указатель конкретного манифеста. Файл лежит в git,
# потому что «быстрый откат» возможен только если предыдущий набор digest зафиксирован в истории:
# git revert этого файла = прежнее состояние состава. Секреты сюда не попадают никогда: они
# читаются файлами из /etc/tbot/secrets (TZ §14.3).
#
# Как обновлять после зелёного CI:
#   gh run view <image-run> --repo rusiksoft-afk/tbot --log | grep "pushing manifest"
# и записывать новые значения сюда одним коммитом, вместе с номером commit, из которого они
# собраны. Проверка перед деплоем: `docker compose ... config` (он же ловит опечатку в digest).

# Образы приложения собраны из commit b235d29 (run Image 44716926556, 2026-11-20 13:10 MSK).
TBOT_WEB_DIGEST=sha256:0f48265114538fbc60aa407cefb9b183f6fa29aa868d2d7590c54eaaea5f970d
TBOT_TGBOT_DIGEST=sha256:873152b3a9178290736f0676ed253817b52702c1db60bd1f788ac4ac6db2e37e
TBOT_ENGINE_DIGEST=sha256:c5c1af5e451db1ddf4b7e1d7efed8accf6fac23fb4e7bed564de069670006e03
TBOT_JOBS_DIGEST=sha256:04070e40b269dce3ed264b131d98cedac5d1c0fca2f1e0cc868f75f3c702753f

# Образ базы — тоже по digest, хотя он и публичный (Docker Hub): площадка и CI должны получать
# один и тот же образ, иначе «учение на площадке» проверяет не ту версию Postgres, что в CI.
# Проверка на площадке: docker image inspect postgres:16.4 --format "{{.RepoDigests}}"
TBOT_POSTGRES_DIGEST=sha256:e62fbf9d3e2b49816a32c400ed2dba83e3b361e6833e624024309c35d334b412

# Обратный прокси. Версия — мажорная ветка `2` (v2.11.9 на момент фиксации), фиксация — digest.
# Обновление majors только осознанно: Caddy меняет поведение ACME и редиректов между минорами.
CADDY_DIGEST=sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
