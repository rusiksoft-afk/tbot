# Caddyfile боевого контура (T-713; TZ §8.3, §14.6).
#
# Кладётся в контейнер read-only (deploy/compose.prod.yaml). Сертификат Caddy получает сам
# через ACME: 80 и 443 должны быть доступны снаружи (SG Yandex Cloud + ufw — T-708), а DNS
# `tbot.rusiksoft.ru` — указывать на 153.51.172.30 (OQ-2, проверено).
#
# Проверка конфигурации без запуска — внутри того же образа, что запускается на площадке
# (digest закреплён в deploy/tbot.prod.env, его же исполняет job `prod-config` в CI):
#   caddy_digest=$(grep -m1 '^CADDY_DIGEST=' deploy/tbot.prod.env | cut -d= -f2)
#   docker run --rm --network none -v "$PWD/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro" \
#     --entrypoint caddy "caddy@$caddy_digest" \
#     validate --config /etc/caddy/Caddyfile --adapter caddyfile
# Фигурных скобок в этом комментарии нет намеренно: контрактный тест разбирает Caddyfile
# по строкам и разрешает их только в коде (иначе проверка структуры врёт).
{
	# Глобальные пределы сервера (TZ §8.3). Важно: встроенного ограничителя частоты запросов
	# в официальном образе Caddy нет — `rate_limit` существует только как сторонний плагин,
	# а его сборка означала бы отказ от публичного digest образа (`docs/runbook/ghcr-pull.md §1`, где
	# фиксируется ровно публичный образ). Поэтому на прокси держим то, что доступно без плагинов: предельный размер
	# заголовков и тайм-аут чтения заголовков (медленные «шляпные» атаки), плюс ограничение
	# размера тела запроса ниже. Счётчики по IP (/login 10/мин/IP, /totp 10/мин/сессия) —
	# прикладной слой, веха M1 (T-102); там же потребуется явно доверять X-Forwarded-For
	# только сети прокси, иначе счётчик считает не пользователей, а один адрес Caddy.
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
		}
		# Протоколы слушателя: h1, h2 и h3 (HTTP/3 по QUIC на udp/443). Набор перечислен явно,
		# потому что он обязан совпадать с набором открытых портов: `allow 443/udp` держит
		# deploy/vps/ufw.rules, а контрактный тест `test_caddyfile_pinned_tls_headers_and_443`
		# проверяет Caddyfile и правила вместе, чтобы они не разъехались. Проход UDP/443 подтверждён
		# замером на площадке 2026-11-20: 20 датаграмм снаружи подняли счётчик цепочки ufw-user-input
		# ровно до 20 пакетов / 900 байт — значит и `ufw`, и группа безопасности облака udp/443
		# пропускают (docs/acceptance/tls-edge.md §3.6).
		# Симметричное следствие: если udp-правило снимается, вместе с ним снимается и h3. Иначе Caddy
		# сам навешивает `Alt-Svc: h3=":443"`, браузер уходит в QUIC, которого сеть не пропускает, и
		# части клиентов не хватает терпения на фолбэк в HTTP/2 — проверка локальным Caddy v2.11.
		protocols h1 h2 h3
	}
}

tbot.rusiksoft.ru {
	# Версии TLS зафиксированы явно, а не «как по умолчанию»: документация Caddy отдельно
	# предупреждает, что дефолты TLS могут меняться в минорных релизах, а конфиг пинается по
	# digest. Значения совпадают с TZ §2 («TLS 1.2/1.3»): минимум 1.2, максимум 1.3.
	# Синтаксис — поддиректива `protocols` внутри `tls`, а не отдельная директория сайта.
	tls {
		protocols tls1.2 tls1.3
	}

	# ACME-почта не указана: Let's Encrypt не требует её обязательно, но без письма
	# предупреждение о скором истечении сертификата придёт только в логи Caddy. Когда заказчик
	# определит ящик — раскомментировать строку ниже: внутри сайта валидна форма
	# `tls <ящик>` (отдельной директивы `email` в блоке сайта нет, `email` — глобальная
	# опция), и это надо сделать до включения боевого контура (TZ §12.4: срок сертификата
	# обязан контролироваться алертом).
	# tls ops@rusiksoft.ru

	# 443 отдаём наружу, HTTP оставляем для редиректа и ACME-вызовов: Caddy сам строит
	# редирект :80 -> :443, отдельный сайт-блок не нужен; вызовы HTTP-01 обрабатывает
	# сам ACME-решатель до редиректа.

	header {
		# TZ §8.3: HSTS с max-age 2 года и includeSubDomains. Указан большой срок —
		# это обещание, а не настройка «на пробу»: после первого визита браузер больше
		# никогда не придёт на http по этому домену и его поддоменам.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"

		# TZ §8.3: CSP фиксированный, без 'unsafe-inline' и без внешних источников.
		# Внешних хостов нет ни в одном источнике: шрифты и JS — самохостящиеся.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; object-src 'none'"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Значение ровно из TZ §8.3 (`same-origin`). Более жёсткий `no-referrer` не выбран
		# без решения заказчика: ТЗ — контракт, и расхождение видно только при приёмке.
		Referrer-Policy "same-origin"
		# Разрешаем только геолокацию и камеру-микротон запрещаем: панель их не использует.
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"

		# Панель приватная, кэш на прокси не нужен; сертификаты и HTML не должны осесть
		# в общем кэше браузера после выхода из кабинета.
		Cache-Control "no-store"

		# `-` = удалить поле (операция откладывается до записи ответа, поэтому снимается и
		# служебный заголовок, который сервер добавляет сам). У приложения `server_header`
		# тоже выключен (apps/web/main.py) — «кто именно стоит за доменом» наружу не виден.
		-Server
	}

	# Ограничение на размер тела запроса: форма импорта сделок и API не должны
	# позволить выложить в панель большой файл через request body. Превышение → 413
	# до обращения к приложению. Форма с блоком обязательна: позиционный аргумент
	# `request_body <число>` в v2.10+ не используется.
	request_body {
		max_size 10MB
	}

	route {
		# Методы, которые нигде не используются легитимно: TRACE/TRACK — классический вектор
		# XST/`Max-forwards`-разведки. DELETE не блокируем: он появится в API панели позже (M1+),
		# и запрет на прокси сломал бы приложение молча.
		@forbidden method TRACE TRACK
		handle @forbidden {
			respond 405
		}

		# Метрики наружу не отдаются: `/metrics` есть у каждого процесса (TZ §12.2), и через
		# прокси он показал бы версию сборки, счётчики запросов и статистику базы. Сбор
		# Prometheus идёт к web:8080 напрямую по контейнерной сети (TZ §14.6), а наружу
		# остаётся только /healthz — им проверяет доступность внешний мониторинг
		# (`curl -I https://tbot.rusiksoft.ru/healthz`, приёмка T-713).
		handle /metrics {
			respond 404
		}

		handle {
			reverse_proxy web:8080 {
				# web слушает внутри сети tbot-public; наружу у него порта нет
				# (deploy/compose.prod.yaml: публикуется только 80/443 Caddy).
				# X-Forwarded-For Caddy добавляет сам; явные поля ниже — чтобы приложение
				# видело протокол и адрес источника (TZ §8.7 аудит входа по IP).
				header_up X-Forwarded-Proto {scheme}
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Журнал доступа идёт в stderr контейнера (ротацию json-file задаёт compose.prod.yaml:
	# 50 МБ × 10). Уровень не занижается: TZ §8.7 требует аудита обращений, а спам от ботов и
	# сканеров удерживает ротация, а не отключение журнала.
	#
	# TZ §8.4 «красное правило»: ни токенов, ни сессий в логах быть не должно. Замер на v2.11.9:
	# Caddy сам пишет REDACTED для Cookie, Set-Cookie, Authorization и Proxy-Authorization — это
	# надо сохранить: глобальная опция `log_credentials` включает их обратно, включать нельзя
	# (контрактный тест запрещает эту опцию в файле). Фильтр ниже закрывает то, что Caddy сам не
	# закрывает: query-параметры (одноразовые ссылки на отчёты, TZ §8.3 — TTL 5 минут, то есть
	# это полноценный доступ) и заголовок X-Api-Key, который в список «чувствительных» не входит.
	# Список ключей query обязан расти вместе с URL-поверхностью панели (M1), иначе новый
	# эндпоинт с токеном в ссылке попадёт в журнал открытым текстом.
	log {
		output stderr
		format filter {
			request>uri query {
				replace token REDACTED
				replace key REDACTED
				replace sig REDACTED
			}
			request>headers>X-Api-Key replace REDACTED
			wrap json
		}
	}

	# Файл блокировки ACME не переиспользуется между запусками: каталог /data смонтирован
	# именованным volumes, то есть сертификат и ACME-аккаунт переживают `up -d`.
}
